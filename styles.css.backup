
    /* ==========================================================================
       PRODDIGI DESIGN SYSTEM — EDITORIAL CINEMATIC DUAL THEME (PURE CSS)
       ========================================================================== */

    :root {
      /* Dark Theme (Default) */
      --bg: #0a0a0b;
      --bg-header: rgba(10, 10, 11, 0.85);
      --surface: #141416;
      --surface-elevated: #1c1c1f;
      --surface-hover: #242429;
      --text: #f4f4f5;
      --text-muted: #8e8e93;
      --text-dim: #5c5c63;
      --border: rgba(255, 255, 255, 0.1);
      --border-subtle: rgba(255, 255, 255, 0.05);
      --logo-invert: 0;
      --hero-overlay-gradient: linear-gradient(180deg, rgba(10, 10, 11, 0.45) 0%, rgba(10, 10, 11, 0.3) 40%, rgba(10, 10, 11, 0.94) 100%);
      --indicator-red: #FF334B;

      /* Typography */
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-mono: 'Space Grotesk', ui-monospace, SFMono-Regular, monospace;

      /* Layout */
      --container-max: 1360px;
      --gutter: clamp(1.25rem, 4vw, 3.5rem);
      --radius-sm: 2px;
      --radius-md: 4px;
      --transition: 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    [data-theme="light"] {
      --bg: #f8f8f9;
      --bg-header: rgba(248, 248, 249, 0.88);
      --surface: #ffffff;
      --surface-elevated: #f0f0f2;
      --surface-hover: #e5e5e8;
      --text: #121214;
      --text-muted: #6e6e73;
      --text-dim: #9898a0;
      --border: rgba(0, 0, 0, 0.08);
      --border-subtle: rgba(0, 0, 0, 0.04);
      --logo-invert: 1;
      --hero-overlay-gradient: linear-gradient(180deg, rgba(10, 10, 11, 0.45) 0%, rgba(10, 10, 11, 0.3) 40%, rgba(10, 10, 11, 0.94) 100%);
      --indicator-red: #E0283F;
    }

    /* Reset & Base */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-family: var(--font-sans);
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.5;
      font-size: 16px;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
      scroll-behavior: smooth;
      transition: background-color 300ms ease, color 300ms ease;
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      background-color: var(--bg);
    }

    a {
      color: inherit;
      text-decoration: none;
      transition: opacity var(--transition), color var(--transition);
    }

    button {
      font-family: inherit;
      background: none;
      border: none;
      color: inherit;
      cursor: pointer;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    /* ==========================================================================
       1. MINIMALIST HEADER (<header>)
       ========================================================================== */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      background-color: var(--bg-header);
      border-bottom: 1px solid var(--border);
      padding: 0.9rem var(--gutter);
      transition: background-color 300ms ease, border-color 300ms ease;

      header .header-container {
        max-width: var(--container-max);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
      }

      header .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;

        header .brand .brand-logo-img {
          height: 26px;
          width: auto;
          filter: invert(var(--logo-invert));
          transition: filter 300ms ease;
          object-fit: contain;
        }

        header .brand .brand-dot {
          display: inline-block;
          width: 6px;
          height: 6px;
          border-radius: 50%;
          background: var(--indicator-red);
          box-shadow: 0 0 8px rgba(255, 51, 75, 0.7);
        }

        header .brand .brand-text {
          font-family: var(--font-sans);
          font-weight: 800;
          font-size: 1.35rem;
          letter-spacing: -0.04em;
          color: var(--text);
          display: inline-flex;
          align-items: baseline;
          gap: 4px;
        }
      }

      header nav {
        display: flex;
        align-items: center;
        gap: 2rem;

        header nav ul {
          display: flex;
          list-style: none;
          gap: 2rem;

          header nav ul a {
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--text-muted);
            letter-spacing: 0.02em;
            position: relative;
            padding-bottom: 3px;

            header nav ul a:hover {
              color: var(--text);
            }

            header nav ul a[aria-current="page"] {
              color: var(--text);
              header nav ul a[aria-current="page"]::after {
                content: "";
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                height: 1px;
                background-color: var(--text);
              }
            }
          }
        }
      }

      header .header-actions {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }

      /* Architectural Segmented Dark/Light Switch (Strictly NO Sun/Moon) */
      header .theme-switch {
        display: inline-flex;
        align-items: center;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 100px;
        padding: 2px;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.05em;

        header .theme-switch button.mode-btn {
          padding: 0.25rem 0.6rem;
          border-radius: 100px;
          color: var(--text-muted);
          transition: all 200ms ease;

          header .theme-switch button.mode-btn.active {
            background: var(--text);
            color: var(--bg);
            font-weight: 700;
          }
        }
      }

      header .lang-switcher {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--text-dim);
        border: 1px solid var(--border);
        padding: 0.25rem 0.6rem;
        border-radius: 100px;
        background: var(--surface);

        header .lang-switcher button {
          color: var(--text-muted);
          padding: 0.05rem 0.2rem;
          transition: color var(--transition);

          header .lang-switcher button:hover {
            color: var(--text);
          }

          header .lang-switcher button.active {
            color: var(--text);
            font-weight: 700;
          }
        }

        header .lang-switcher span.divider {
          user-select: none;
          opacity: 0.4;
        }
      }

      header .menu-toggle {
        display: none;
        padding: 0.4rem;
        color: var(--text);
      }

      header .theme-toggle {
        position: relative;
        width: 40px;
        height: 20px;
        border-radius: 999px;
        background: var(--surface-elevated);
        border: 1px solid var(--border);
        cursor: pointer;
        padding: 2px;
        display: inline-flex;
        align-items: center;
        transition: background-color 200ms, border-color 200ms;
      }

      header .theme-thumb {
        display: block;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--text);
      }
    }

    @media (max-width: 860px) {
      header nav {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        background: var(--bg);
        border-bottom: 1px solid var(--border);
        padding: 1.25rem var(--gutter);
        flex-direction: column;
        gap: 0.25rem;
        z-index: 110;
      }

      header nav ul {
        flex-direction: column;
        gap: 0.25rem;
        width: 100%;
      }

      header nav li a {
        padding: 0.85rem 0.25rem;
      }

      header nav .lang-switcher {
        padding: 0.7rem 0.85rem;
        border-radius: 12px;
        gap: 0.4rem;
        width: 100%;
      }

      header nav.is-open {
        display: flex;
      }

      header .menu-toggle {
        display: block;
      }
    }

    /* ==========================================================================
       2. FULL-BLEED CINEMATIC HERO SECTION (100vw, 100vh / full edge-to-edge)
       ========================================================================== */
    section.hero-cinema {
      position: relative;
      width: 100vw;
      min-height: 92vh;
      height: 95vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      color: #F4F4F5; /* Keep hero cinematic dark regardless of light mode body */

      section.hero-cinema .hero-backdrop-container {
        position: absolute;
        inset: 0;
        z-index: 1;
        overflow: hidden;

        section.hero-cinema .hero-backdrop-container img.hero-bg-media {
          width: 100%;
          height: 100%;
          object-fit: cover;
          object-position: center 40%;
          transform: scale(1.02);
          filter: contrast(106%) brightness(92%);
          animation: subtleZoom 25s ease-out infinite alternate;
        }

        /* Vignette + cinematic gradient */
        section.hero-cinema .hero-backdrop-container .hero-vignette {
          position: absolute;
          inset: 0;
          background: var(--hero-overlay-gradient);
          pointer-events: none;
        }

        /* Subtle 35mm film grain overlay simulated */
        section.hero-cinema .hero-backdrop-container .film-grain {
          position: absolute;
          inset: 0;
          opacity: 0.08;
          pointer-events: none;
          background-image: radial-gradient(#fff 1px, transparent 0);
          background-size: 4px 4px;
        }
      }

      section.hero-cinema .hero-top-bar {
        position: relative;
        z-index: 2;
        padding: clamp(2rem, 4vw, 3rem) var(--gutter) 0;
        max-width: var(--container-max);
        width: 100%;
        margin: 0 auto;

        section.hero-cinema .hero-top-bar .tech-badge {
          display: inline-flex;
          align-items: center;
          gap: 0.75rem;
          font-family: var(--font-mono);
          font-size: 0.75rem;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: rgba(244, 244, 245, 0.85);
          background: rgba(10, 10, 11, 0.65);
          backdrop-filter: blur(10px);
          padding: 0.4rem 0.9rem;
          border-radius: 100px;
          border: 1px solid rgba(255, 255, 255, 0.15);

          section.hero-cinema .hero-top-bar .tech-badge .rec-pulse {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: #FF334B;
            animation: pulseRec 1.8s infinite;
          }
        }
      }

      section.hero-cinema .hero-center-content {
        position: relative;
        z-index: 2;
        max-width: var(--container-max);
        width: 100%;
        margin: 0 auto;
        padding: 0 var(--gutter);
        display: flex;
        flex-direction: column;
        gap: 1.5rem;

        section.hero-cinema .hero-center-content .hero-title-area {
          max-width: 1040px;

          section.hero-cinema .hero-center-content .hero-title-area h1 {
            font-size: clamp(2.4rem, 5.5vw, 5.2rem);
            font-weight: 700;
            line-height: 1.02;
            letter-spacing: -0.04em;
            color: #ffffff;
            text-shadow: 0 4px 30px rgba(0, 0, 0, 0.7);

            section.hero-cinema .hero-center-content .hero-title-area h1 span.narrative-span {
              display: block;
              font-weight: 300;
              color: rgba(244, 244, 245, 0.85);
              font-style: italic;
            }
          }

          section.hero-cinema .hero-center-content .hero-title-area p.studio-manifesto {
            margin-top: 1.25rem;
            font-size: clamp(1rem, 1.3vw, 1.25rem);
            color: rgba(244, 244, 245, 0.75);
            max-width: 680px;
            line-height: 1.6;
            font-weight: 400;
          }
        }

        section.hero-cinema .hero-center-content .hero-cta-action {
          margin-top: 1rem;
          display: flex;
          align-items: center;
          gap: 1.5rem;

          section.hero-cinema .hero-center-content .hero-cta-action button.play-reel-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            background: rgba(10, 10, 11, 0.5);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: #ffffff;
            padding: 0.5rem 1.15rem;
            border-radius: 999px;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            font-weight: 500;
            transition: 200ms;
            cursor: pointer;
          }

          section.hero-cinema .hero-center-content .hero-cta-action button.play-reel-btn .play-icon {
            display: inline-block;
            width: 0;
            height: 0;
            border-top: 4px solid transparent;
            border-bottom: 4px solid transparent;
            border-left: 7px solid #ffffff;
            margin-right: 2px;
          }
        }
      }

      /* Camera & Film Technical Readout Edge Bar */
      section.hero-cinema .hero-bottom-telemetry {
        position: relative;
        z-index: 2;
        width: 100%;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(10, 10, 11, 0.7);
        backdrop-filter: blur(12px);
        padding: 0.85rem var(--gutter);

        section.hero-cinema .hero-bottom-telemetry .telemetry-container {
          max-width: var(--container-max);
          margin: 0 auto;
          display: flex;
          justify-content: space-between;
          align-items: center;
          font-family: var(--font-mono);
          font-size: 0.72rem;
          color: rgba(244, 244, 245, 0.6);
          letter-spacing: 0.06em;
          text-transform: uppercase;

          section.hero-cinema .hero-bottom-telemetry .telemetry-container .tech-left, .tech-right {
            display: flex;
            gap: 1.5rem;
            align-items: center;
          }

          section.hero-cinema .hero-bottom-telemetry .telemetry-container span.spec-highlight {
            color: #ffffff;
            font-weight: 600;
          }
        }
      }
    }

    @keyframes pulseRec {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(0.85); }
    }

    @keyframes subtleZoom {
      0% { transform: scale(1.02); }
      100% { transform: scale(1.06); }
    }

    /* ==========================================================================
       MAIN CONTENT CONTAINER
       ========================================================================== */
    main {
      flex: 1;
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--gutter);
    }

    /* ==========================================================================
       3. SELECTED WORKS / PORTFOLIO GRID
       ========================================================================== */
    section.portfolio-section {
      padding-top: clamp(4rem, 8vw, 7rem);
      padding-bottom: clamp(4rem, 8vw, 7rem);

      section.portfolio-section .section-heading-bar {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-bottom: 3rem;
        border-bottom: 1px solid var(--border);
        padding-bottom: 1.5rem;

        @media (min-width: 820px) {
          flex-direction: row;
          justify-content: space-between;
          align-items: flex-end;
        }

        section.portfolio-section .section-heading-bar .heading-meta {
          section.portfolio-section .section-heading-bar .heading-meta .meta-label {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
            display: block;
          }

          section.portfolio-section .section-heading-bar .heading-meta h2 {
            font-size: clamp(1.8rem, 3.2vw, 2.8rem);
            letter-spacing: -0.035em;
            font-weight: 700;
            color: var(--text);
          }
        }

        /* Clean Filter Bar */
        section.portfolio-section .section-heading-bar nav.filter-bar {
          display: flex;
          gap: 1.5rem;
          overflow-x: auto;
          scrollbar-width: none;
          padding-bottom: 0.25rem;

          section.portfolio-section .section-heading-bar nav.filter-bar::-webkit-scrollbar {
            display: none;
          }

          section.portfolio-section .section-heading-bar nav.filter-bar button.filter-btn {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--text-muted);
            padding: 0.4rem 0;
            position: relative;
            transition: color var(--transition);
            white-space: nowrap;

            section.portfolio-section .section-heading-bar nav.filter-bar button.filter-btn::after {
              content: "";
              position: absolute;
              bottom: -1.5rem;
              left: 0;
              width: 100%;
              height: 2px;
              background-color: transparent;
              transition: background-color var(--transition);
            }

            section.portfolio-section .section-heading-bar nav.filter-bar button.filter-btn:hover {
              color: var(--text);
            }

            section.portfolio-section .section-heading-bar nav.filter-bar button.filter-btn.active {
              color: var(--text);
              font-weight: 700;

              section.portfolio-section .section-heading-bar nav.filter-bar button.filter-btn.active::after {
                background-color: var(--text);
              }
            }
          }
        }
      }

      /* Portfolio 2-column Grid */
      section.portfolio-section .portfolio-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(2.5rem, 5vw, 4.5rem);

        @media (min-width: 768px) {
          grid-template-columns: repeat(2, 1fr);
        }

        section.portfolio-section .portfolio-grid article.cinema-card {
          display: flex;
          flex-direction: column;
          gap: 1.25rem;
          cursor: pointer;
          position: relative;

          section.portfolio-section .portfolio-grid article.cinema-card.hidden {
            display: none;
          }

          section.portfolio-section .portfolio-grid article.cinema-card figure.card-frame {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            background-color: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            overflow: hidden;

            section.portfolio-section .portfolio-grid article.cinema-card figure.card-frame img.card-still {
              width: 100%;
              height: 100%;
              object-fit: cover;
              filter: grayscale(8%) contrast(105%);
              transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1), filter var(--transition);
            }

            section.portfolio-section .portfolio-grid article.cinema-card figure.card-frame .duration-pill {
              position: absolute;
              bottom: 0.85rem;
              right: 0.85rem;
              background: rgba(10, 10, 11, 0.85);
              border: 1px solid rgba(255, 255, 255, 0.2);
              font-family: var(--font-mono);
              font-size: 0.72rem;
              color: #f4f4f5;
              padding: 0.2rem 0.55rem;
              border-radius: var(--radius-sm);
              backdrop-filter: blur(6px);
              z-index: 2;
            }

            section.portfolio-section .portfolio-grid article.cinema-card figure.card-frame .hover-play-layer {
              position: absolute;
              inset: 0;
              background: rgba(10, 10, 11, 0.45);
              display: grid;
              place-items: center;
              opacity: 0;
              transition: opacity var(--transition);
              z-index: 3;

              section.portfolio-section .portfolio-grid article.cinema-card figure.card-frame .hover-play-layer .circle-play {
                width: 54px;
                height: 54px;
                border-radius: 50%;
                background: #ffffff;
                display: grid;
                place-items: center;
                transform: scale(0.85);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
                transition: transform var(--transition);

                section.portfolio-section .portfolio-grid article.cinema-card figure.card-frame .hover-play-layer .circle-play svg {
                  width: 18px;
                  height: 18px;
                  fill: #0a0a0b;
                  margin-left: 2px;
                }
              }
            }
          }

          section.portfolio-section .portfolio-grid article.cinema-card:hover {
            section.portfolio-section .portfolio-grid article.cinema-card:hover figure.card-frame img.card-still {
              transform: scale(1.035);
              filter: grayscale(0%) contrast(108%);
            }

            section.portfolio-section .portfolio-grid article.cinema-card:hover .hover-play-layer {
              opacity: 1;

              section.portfolio-section .portfolio-grid article.cinema-card:hover .hover-play-layer .circle-play {
                transform: scale(1);
              }
            }
          }

          section.portfolio-section .portfolio-grid article.cinema-card figcaption.card-caption {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;

            section.portfolio-section .portfolio-grid article.cinema-card figcaption.card-caption .meta-row {
              display: flex;
              justify-content: space-between;
              align-items: center;
              font-family: var(--font-mono);
              font-size: 0.75rem;
              color: var(--text-dim);
              text-transform: uppercase;
              letter-spacing: 0.05em;
            }

            section.portfolio-section .portfolio-grid article.cinema-card figcaption.card-caption .title-row {
              display: flex;
              align-items: center;
              justify-content: space-between;
              gap: 1rem;

              section.portfolio-section .portfolio-grid article.cinema-card figcaption.card-caption .title-row h3 {
                font-size: clamp(1.15rem, 1.8vw, 1.45rem);
                font-weight: 700;
                letter-spacing: -0.03em;
                color: var(--text);
                transition: color var(--transition);
              }

              section.portfolio-section .portfolio-grid article.cinema-card figcaption.card-caption .title-row svg.arrow-icon {
                width: 18px;
                height: 18px;
                stroke: var(--text-muted);
                stroke-width: 2;
                fill: none;
                flex-shrink: 0;
                transition: transform var(--transition), stroke var(--transition);
              }
            }

            section.portfolio-section .portfolio-grid article.cinema-card figcaption.card-caption p.client-info {
              font-size: 0.88rem;
              color: var(--text-muted);
              font-weight: 400;
            }
          }

          section.portfolio-section .portfolio-grid article.cinema-card:hover figcaption .title-row svg.arrow-icon {
            transform: translate(3px, -3px);
            stroke: var(--text);
          }
        }
      }
    }

    /* ==========================================================================
       4. NATIVE VIDEO LIGHTBOX (<dialog>)
       ========================================================================== */
    dialog#videoLightbox {
      position: fixed;
      inset: 0;
      margin: auto;
      max-width: 1040px;
      width: calc(100% - 2.5rem);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      color: var(--text);
      padding: 0;
      box-shadow: 0 35px 90px rgba(0, 0, 0, 0.85);
      outline: none;

      dialog#videoLightbox::backdrop {
        background-color: rgba(10, 10, 11, 0.94);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
      }

      dialog#videoLightbox .dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.9rem 1.4rem;
        border-bottom: 1px solid var(--border);
        background: var(--surface-elevated);

        dialog#videoLightbox .dialog-header .dialog-title-meta {
          display: flex;
          align-items: center;
          gap: 0.6rem;
          font-family: var(--font-mono);
          font-size: 0.75rem;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          color: var(--text-muted);

          dialog#videoLightbox .dialog-header .dialog-title-meta .diag-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--indicator-red);
          }
        }

        dialog#videoLightbox .dialog-header button.dialog-close {
          width: 32px;
          height: 32px;
          display: grid;
          place-items: center;
          border-radius: var(--radius-sm);
          color: var(--text-muted);
          transition: background-color var(--transition), color var(--transition);

          dialog#videoLightbox .dialog-header button.dialog-close:hover {
            background-color: var(--surface-hover);
            color: var(--text);
          }

          dialog#videoLightbox .dialog-header button.dialog-close svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
            stroke-width: 2;
          }
        }
      }

      dialog#videoLightbox .dialog-body {
        aspect-ratio: 16 / 9;
        width: 100%;
        background-color: #000;

        dialog#videoLightbox .dialog-body iframe {
          width: 100%;
          height: 100%;
          border: none;
          display: block;
        }
      }

      dialog#videoLightbox .dialog-footer {
        padding: 1.1rem 1.4rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--surface);
        border-top: 1px solid var(--border-subtle);

        dialog#videoLightbox .dialog-footer .dialog-meta-details {
          dialog#videoLightbox .dialog-footer .dialog-meta-details h4 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text);
          }
          dialog#videoLightbox .dialog-footer .dialog-meta-details p {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 0.15rem;
          }
        }

        dialog#videoLightbox .dialog-footer a.vimeo-external-link {
          font-family: var(--font-mono);
          font-size: 0.8rem;
          color: var(--text-muted);
          text-decoration: underline;
          text-underline-offset: 3px;

          dialog#videoLightbox .dialog-footer a.vimeo-external-link:hover {
            color: var(--text);
          }
        }
      }
    }

    /* ==========================================================================
       5. AUTHENTIC PRODDIGI FOOTER (<footer>)
       ========================================================================== */
    footer {
      border-top: 1px solid var(--border);
      background-color: var(--bg);
      padding: clamp(3.5rem, 6vw, 6rem) var(--gutter) 2.5rem;
      transition: background-color 300ms ease, border-color 300ms ease;

      footer .footer-container {
        max-width: var(--container-max);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr;
        gap: 3.5rem;

        @media (min-width: 768px) {
          grid-template-columns: 1.4fr 1fr 1fr;
        }

        footer .footer-container .footer-col {
          display: flex;
          flex-direction: column;
          gap: 1.1rem;

          footer .footer-container .footer-col .col-label {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-dim);
          }

          footer .footer-container .footer-col address {
            font-style: normal;
            font-size: 0.95rem;
            color: var(--text-muted);
            line-height: 1.65;

            footer .footer-container .footer-col address strong {
              color: var(--text);
              font-weight: 600;
            }
          }

          footer .footer-container .footer-col .contact-links, .social-links {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.65rem;

            footer .footer-container .footer-col .contact-links, .social-links a {
              font-size: 0.95rem;
              color: var(--text-muted);
              display: inline-flex;
              align-items: center;
              gap: 0.5rem;

              footer .footer-container .footer-col .contact-links, .social-links a:hover {
                color: var(--text);
                transform: translateX(2px);
              }
            }
          }
        }
      }

      footer .footer-bottom {
        max-width: var(--container-max);
        margin: clamp(3rem, 5vw, 4.5rem) auto 0;
        padding-top: 2rem;
        border-top: 1px solid var(--border-subtle);
        display: flex;
        flex-direction: column;
        gap: 1rem;
        justify-content: space-between;
        align-items: flex-start;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-dim);

        @media (min-width: 640px) {
          flex-direction: row;
          align-items: center;
        }

        footer .footer-bottom .credits {
          display: flex;
          gap: 1.5rem;
        }
      }
    }

/* ==========================================================================
   Estudí section classes (replacing inline styles)
   ========================================================================== */
section#estudi {
  padding-top: clamp(4rem, 8vw, 6.5rem);
  padding-bottom: clamp(4rem, 8vw, 6.5rem);
  border-top: 1px solid var(--border);
}

.estudi-container {
  display: flex;
  flex-direction: column;
  gap: 3.5rem;
}

.estudi-heading-bar {
  border-bottom: 1px solid var(--border);
  padding-bottom: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.estudi-meta-label {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
}

.estudi-heading {
  font-size: clamp(2rem, 3.8vw, 3.2rem);
  letter-spacing: -0.04em;
  font-weight: 700;
  color: var(--text);
}

.estudi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: clamp(2rem, 4vw, 3.5rem);
}

.estudi-item {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.estudi-item-label {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: #FF334B;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.estudi-item-title {
  font-size: 1.3rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text);
}

.estudi-item-desc {
  font-size: 0.95rem;
  color: var(--text-muted);
  line-height: 1.7;
}

.estudi-contact-card {
  border: 1px solid var(--border);
  background: var(--surface);
  padding: 1.75rem 2rem;
  border-radius: var(--radius-sm);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 1.5rem;
}

.estudi-contact-info {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.estudi-contact-label {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  text-transform: uppercase;
  color: var(--text-dim);
  letter-spacing: 0.06em;
}

.estudi-contact-address {
  font-size: 1rem;
  color: var(--text);
  font-weight: 600;
}

.estudi-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 0.65rem 1.25rem;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--surface-elevated);
  color: var(--text);
  font-weight: 600;
  transition: background-color 200ms ease;
}

/* ==========================================================================
   Lightbox dialog footer classes (replacing inline styles)
   ========================================================================== */
.dialog-footer-inner {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.dialog-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.dialog-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.02em;
}

.dialog-client {
  font-size: 0.88rem;
  color: var(--text-muted);
  margin-top: 0.25rem;
}

.dialog-specs-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border-subtle);
  font-family: var(--font-mono);
  font-size: 0.72rem;
}

.dialog-spec-label {
  display: block;
  color: var(--text-dim);
  text-transform: uppercase;
  margin-bottom: 2px;
}

.dialog-spec-value {
  color: var(--text);
  font-weight: 600;
}

/* ==========================================================================
   Credits link
   ========================================================================== */
.credits-link {
  text-decoration: underline;
  color: inherit;
}
  